{
  "name": "baton",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "description": "Central queue and control plane for AI coding agents running on remote dev machines",
  "engines": {
    "node": ">=24"
  },
  "scripts": {
    "server": "node --no-warnings=ExperimentalWarning src/index.ts",
    "runner": "node --no-warnings=ExperimentalWarning src/runner/index.ts",
    "enroll": "node --no-warnings=ExperimentalWarning src/enroll.ts",
    "floor": "node --no-warnings=ExperimentalWarning src/enroll.ts --floor-only",
    "cli": "node --no-warnings=ExperimentalWarning src/cli.ts",
    "backup": "node --no-warnings=ExperimentalWarning scripts/backup.ts",
    "typecheck": "tsc --noEmit",
    "test": "npm run typecheck && npm run test:smoke && npm run test:api && npm run test:page && npm run test:wizard && npm run test:enroll && npm run test:runner && npm run test:oauth",
    "test:smoke": "node --no-warnings=ExperimentalWarning test/smoke.ts",
    "test:api": "node --no-warnings=ExperimentalWarning test/api.ts",
    "test:runner": "node --no-warnings=ExperimentalWarning test/runner.ts",
    "test:oauth": "node --no-warnings=ExperimentalWarning test/oauth.ts",
    "test:page": "node --no-warnings=ExperimentalWarning test/page.ts",
    "test:enroll": "node --no-warnings=ExperimentalWarning test/enroll.ts",
    "test:wizard": "node --no-warnings=ExperimentalWarning test/wizard.ts"
  },
  "dependencies": {
    "@modelcontextprotocol/sdk": "^1.32.2",
    "express": "^5.3.0",
    "express-rate-limit": "^8.7.1",
    "zod": "^4.6.7"
  },
  "devDependencies": {
    "@types/express": "^5.0.6",
    "@types/node": "^24.0.0",
    "typescript": "^5.7.0"
  }
}
