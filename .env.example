# Copy to .env on the server and fill in. .env is gitignored; keep it 0600.

# The hostname Caddy gets a certificate for. Must already resolve to this box.
BATON_DOMAIN=baton.example.com

# The public origin. Required for OAuth, which is how the Claude mobile and
# desktop apps connect.
BATON_PUBLIC_URL=https://baton.example.com

# Bearer token for /mcp, which is full control of every worker. Used by Claude
# Code, which can send a static header. Generate with:
#   openssl rand -hex 32
BATON_ADMIN_TOKEN=

# Password for the OAuth consent screen, which is what you type on your phone
# when connecting the Claude app. It grants the same full control, so make it
# strong -- but it defaults to BATON_ADMIN_TOKEN, and typing 64 hex characters on
# a phone is miserable, so set something long and memorable instead.
BATON_LOGIN_PASSWORD=

# ntfy topic for push notifications.
#
# Treat this as a secret: on a public ntfy server anyone who knows the topic
# name can read your notifications, which include what an agent is asking you
# to approve. Use a long random name, not "lucas-baton". Generate with:
#   openssl rand -hex 16
BATON_NTFY_TOPIC=
BATON_NTFY_URL=https://ntfy.sh

# Optional overrides; the defaults are fine.
# BATON_APPROVAL_WAIT_MS=21600000
# BATON_BLOCKED_REMINDER_MS=1200000
