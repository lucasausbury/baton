# Copy to .env on the server and fill in. .env is gitignored; keep it 0600.

# The hostname Caddy gets a certificate for. Must already resolve to this box.
AWM_DOMAIN=awm.example.com

# Bearer token for /mcp, which is full control of every worker. Generate with:
#   openssl rand -hex 32
AWM_ADMIN_TOKEN=

# ntfy topic for push notifications.
#
# Treat this as a secret: on a public ntfy server anyone who knows the topic
# name can read your notifications, which include what an agent is asking you
# to approve. Use a long random name, not "lucas-awm". Generate with:
#   openssl rand -hex 16
AWM_NTFY_TOPIC=
AWM_NTFY_URL=https://ntfy.sh

# Used to attach a click-through link to each push.
AWM_PUBLIC_URL=https://awm.example.com

# Optional overrides; the defaults are fine.
# AWM_APPROVAL_WAIT_MS=21600000
# AWM_BLOCKED_REMINDER_MS=1200000
